    <string name="privacy_title">Privacy &amp; permissions</string>
    <string name="privacy_open">Why we need access</string>
    <string name="privacy_body">GymMonth counts gym visits this calendar month from Health Connect strength and gym-like workouts. Totals stay on this phone. No data is uploaded.</string>
    <string name="privacy_permissions_list">We request read access to:\n• Exercise sessions (to find strength / gym workouts)\n• Background read (optional, for the home-screen widget)\n\nWe never write workouts and do not request health history beyond the platform default window. Distance is not required for visit counts.</string>
    <string name="privacy_no_network">GymMonth does not use the network in v1. Derived monthly visit totals are stored only on device and excluded from backup. Optional vault write (Settings) only writes Markdown into your local Obsidian vault folder.</string>
